{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leekanghyun/harness-mirror-repo/kangto-factory/harness.schema.json",
  "title": "Harness Manifest",
  "description": "Machine-readable record of a harness (agent team + skills) generated by kangto-factory. Lives at .claude/harness.json.",
  "type": "object",
  "required": ["name", "version", "domain", "executionMode", "pattern", "orchestrator", "agents", "skills", "changelog"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "description": "Harness identifier (kebab-case)." },
    "version": { "type": "string", "description": "Semver, e.g. 1.0.0." },
    "domain": { "type": "string", "description": "One-line domain/purpose of the harness." },
    "createdAt": { "type": "string", "format": "date", "description": "YYYY-MM-DD." },
    "executionMode": { "type": "string", "enum": ["team", "subagent", "hybrid"] },
    "pattern": {
      "type": "string",
      "enum": ["pipeline", "fan-out-fan-in", "expert-pool", "producer-reviewer", "supervisor", "hierarchical", "composite"]
    },
    "orchestrator": { "type": "string", "description": "Path to the orchestrator SKILL.md." },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "model", "file", "role"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["general-purpose", "Explore", "Plan", "custom"],
            "description": "Built-in subagent_type, or 'custom' for a fully defined agent."
          },
          "model": { "type": "string", "enum": ["opus", "sonnet", "haiku"] },
          "file": { "type": "string", "description": "Path to the agent .md definition." },
          "skills": { "type": "array", "items": { "type": "string" }, "description": "Names of skills this agent uses." },
          "role": { "type": "string", "description": "One-line role." }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "file", "usedBy"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "file": { "type": "string", "description": "Path to the skill SKILL.md." },
          "usedBy": { "type": "array", "items": { "type": "string" }, "description": "Agent names that use this skill." }
        }
      }
    },
    "changelog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "change", "target", "reason"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "format": "date" },
          "change": { "type": "string" },
          "target": { "type": "string", "description": "What was changed (e.g. 'all', 'agents/qa.md')." },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
